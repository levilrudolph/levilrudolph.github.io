{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/editorial/**",
              "components/press/**",
              "ui_kits/portfolio/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Fraunces|Newsreader))/i]",
        "message": "Font not provided by the design system. Available: Fraunces, Newsreader."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|as|href|disabled|onClick|style|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, as, href, disabled, onClick, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Byline'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|style|key|ref|className|style|children)$/]",
        "message": "<Byline> doesn't accept that prop. Declared props: name, role, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Caption'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|children|key|ref|className|style|children)$/]",
        "message": "<Caption> doesn't accept that prop. Declared props: style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Clipping'] > JSXAttribute > JSXIdentifier[name!=/^(?:over|title|jump|href|onClick|style|children|key|ref|className|style|children)$/]",
        "message": "<Clipping> doesn't accept that prop. Declared props: over, title, jump, href, onClick, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Columns'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|style|children|key|ref|className|style|children)$/]",
        "message": "<Columns> doesn't accept that prop. Declared props: count, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dinkus'] > JSXAttribute > JSXIdentifier[name!=/^(?:mark|style|key|ref|className|style|children)$/]",
        "message": "<Dinkus> doesn't accept that prop. Declared props: mark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DropCap'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|children|key|ref|className|style|children)$/]",
        "message": "<DropCap> doesn't accept that prop. Declared props: style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Folio'] > JSXAttribute > JSXIdentifier[name!=/^(?:publication|middle|right|style|key|ref|className|style|children)$/]",
        "message": "<Folio> doesn't accept that prop. Declared props: publication, middle, right, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InlineLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|style|children|key|ref|className|style|children)$/]",
        "message": "<InlineLink> doesn't accept that prop. Declared props: href, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|children|key|ref|className|style|children)$/]",
        "message": "<Kicker> doesn't accept that prop. Declared props: style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Masthead'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|the|dateline|rule|style|key|ref|className|style|children)$/]",
        "message": "<Masthead> doesn't accept that prop. Declared props: name, the, dateline, rule, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NewsPhoto'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|ratio|style|key|ref|className|style|children)$/]",
        "message": "<NewsPhoto> doesn't accept that prop. Declared props: src, alt, ratio, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute > JSXIdentifier[name!=/^(?:cite|style|children|key|ref|className|style|children)$/]",
        "message": "<PullQuote> doesn't accept that prop. Declared props: cite, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|style|key|ref|className|style|children)$/]",
        "message": "<Rule> doesn't accept that prop. Declared props: variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:hair|heavy|oxford|dotted)$/]",
        "message": "<Rule> variant must be one of 'hair' | 'heavy' | 'oxford' | 'dotted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHead'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|note|children|style|key|ref|className|style|children)$/]",
        "message": "<SectionHead> doesn't accept that prop. Declared props: label, note, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:spot|style|children|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: spot, style, children."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
